<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>BlueDotBrigade.DatenLokator</PackageId>
		<Version>2.4.0</Version>
		<Authors>BlueDotBrigade;</Authors>
		<Copyright>© 2026 Blue Dot Brigade. All rights reserved.</Copyright>
		<Owners>Blue Dot Brigade</Owners>
		<Title>DatenLokator</Title>
		<Summary>Project summary.</Summary>
		<Description>Simplifies testing by automatically selecting the appropriate input data for a given test case.</Description>
		<IsPackable>true</IsPackable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>This libary is currently a work in progress (WIP). As a result, backwards compatibility is not guaranteed.</PackageReleaseNotes>
		<PackageTags>BlueDotBrigade;Framework;TDD;Test;TestFramework;Test;Testing;UnitTest;</PackageTags>
		<PackageProjectUrl>https://github.com/BlueDotBrigade/daten-lokator</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/BlueDotBrigade/daten-lokator</RepositoryUrl>
		<Platforms>x64</Platforms>
		<!--
			Packaging (#52): only `dotnet pack`, or Visual Studio's Pack command, creates the NuGet package, and only from a Release build.
			- A build never creates the package, in Debug or in Release. `GeneratePackageOnBuild` is deliberately not set:
			  with it, `dotnet pack` skips its build step, and fails on a clean checkout with NU5026.
			- `dotnet pack` builds before it packs, in Release by default.
			- Packing any other configuration stops with an error: see the RequireReleaseToPack target below.
			  2.4.0 was published from a Debug build, which BenchmarkDotNet refuses to measure alongside.
		-->
		<!-- The PDB is embedded in the DLL, so stack traces show file names and line numbers. The DLL is still optimized in Release. -->
		<DebugType>embedded</DebugType>
		<Company>Blue Dot Brigade</Company>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<CodeAnalysisDictionary Include="..\..\DomainSpecificTerminology.xml">
			<Link>Properties\DomainSpecificTerminology.xml</Link>
		</CodeAnalysisDictionary>
	</ItemGroup>
	<!--
		Stops a pack of any configuration but Release, before the package is written (#52).
		It runs before GenerateNuspec: before the Pack target itself would be too late, because the package already exists by then.
	-->
	<Target Name="RequireReleaseToPack" BeforeTargets="GenerateNuspec" Condition="'$(Configuration)' != 'Release'">
		<Error Text="The NuGet package is created only from a Release build, so that it is optimized (#52). Run: dotnet pack -c Release" />
	</Target>
</Project>